# Example .env for local development / production template
# Copy this to .env and fill values (DO NOT commit .env itself)

NODE_ENV=production
PORT=3000
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info
MORGAN_FORMAT=tiny
SOCKET_PATH=/api/socket.io

# REQUIRED
ADMIN_USER=admin
ADMIN_PASSWORD=YourAdminPassw0rd!
ADMIN_SECRET=replace-with-32+chars
PATHFINDER_USER=pathfinder
PATHFINDER_PASSWORD=YourPathfinderPassw0rd!
SESSION_SECRET=replace-with-32+chars
YOUTUBE_API_KEY=replace-with-your-key

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
CORS_ORIGINS=http://localhost:3000
ALLOW_EXTENSION_ORIGINS=false
# 何段のリバースプロキシを信頼するか。X-Forwarded-For の右から数えてクライアント IP を決める。
# 直接公開なら 0、Render など前段が1段なら 1。本番の既定は 1。
TRUSTED_PROXY_HOPS=1

# MongoDB (例): 永続化を MongoDB に切り替える場合は PERSISTENCE_PROVIDER を `mongo` にして MONGODB_URI を設定してください
# PERSISTENCE_PROVIDER: file | mongo
PERSISTENCE_PROVIDER=file
# MONGODB_URI の例（コメント解除して値を入れてください）:
# MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_URI=
MONGODB_DB_NAME=musicReq
MONGODB_COLLECTION=musicRequests
